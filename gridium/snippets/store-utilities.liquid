<div class="floating-stack">
  {%- if settings.enable_whatsapp and settings.whatsapp_number != blank -%}
    <a
      class="floating-btn"
      href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}?text={{ settings.whatsapp_message | url_encode }}"
      target="_blank"
      rel="noopener"
      aria-label="{{ 'general.whatsapp_label' | t }}"
    >
      {% render 'icon', name: 'whatsapp', size: 20 %}
    </a>
  {%- endif -%}

  {%- if settings.enable_back_to_top -%}
    <button type="button" class="floating-btn floating-btn--backtop" data-back-to-top aria-label="{{ 'general.back_to_top' | t }}">
      {% render 'icon', name: 'arrow-up', size: 18 %}
    </button>
  {%- endif -%}
</div>

{%- if settings.enable_cookie_notice -%}
  <aside class="cookie-banner" data-cookie-banner hidden aria-label="Cookie preferences">
    <p style="font-size:0.8125rem;">{{ settings.cookie_notice_text }}</p>
    <div style="display:flex;gap:8px;">
      <button type="button" class="button button--sm" data-cookie-action="accepted">{{ 'general.cookie.accept' | t }}</button>
      <button type="button" class="button button--secondary button--sm" data-cookie-action="essential">{{ 'general.cookie.decline' | t }}</button>
    </div>
  </aside>
{%- endif -%}

{%- if settings.enable_newsletter_popup -%}
  <div id="NewsletterPopupModal" class="modal-overlay" aria-hidden="true" role="dialog" aria-modal="true" data-delay="{{ settings.newsletter_popup_delay | default: 8 }}">
    <div class="modal-panel" style="max-width:480px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <span class="mono-label">STUDIO DISPATCH</span>
        <button type="button" class="icon-btn" data-overlay-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close', size: 18 %}</button>
      </div>
      <h2 class="h3" style="margin-bottom:10px;">{{ settings.newsletter_popup_heading }}</h2>
      <p class="text-muted" style="margin-bottom:20px;font-size:0.9375rem;">{{ settings.newsletter_popup_text }}</p>
      {%- form 'customer', id: 'PopupNewsletterForm' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div style="display:grid;gap:10px;">
          <input type="email" name="contact[email]" class="field__input" required placeholder="{{ 'general.newsletter.placeholder' | t }}" aria-label="{{ 'general.newsletter.label' | t }}">
          <button type="submit" class="button button--full">{{ 'general.newsletter.button' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
{%- endif -%}
