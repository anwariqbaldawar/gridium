{%- unless template == 'index' or template == 'cart' or template == '404' -%}
  <nav class="breadcrumbs" aria-label="{{ 'accessibility.breadcrumbs' | t }}">
    <div class="container">
      <ol class="breadcrumbs__list mono-label">
        <li>
          <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
        </li>
        {%- if template.name == 'product' -%}
          {%- if collection.url -%}
            <li class="breadcrumbs__sep" aria-hidden="true">/</li>
            <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
          {%- else -%}
            <li class="breadcrumbs__sep" aria-hidden="true">/</li>
            <li><a href="{{ routes.all_products_collection_url }}">{{ 'collections.all_products' | t }}</a></li>
          {%- endif -%}
          <li class="breadcrumbs__sep" aria-hidden="true">/</li>
          <li aria-current="page">{{ product.title }}</li>
        {%- elsif template.name == 'collection' -%}
          <li class="breadcrumbs__sep" aria-hidden="true">/</li>
          <li aria-current="page">{{ collection.title }}</li>
        {%- elsif template.name == 'page' -%}
          <li class="breadcrumbs__sep" aria-hidden="true">/</li>
          <li aria-current="page">{{ page.title }}</li>
        {%- else -%}
          <li class="breadcrumbs__sep" aria-hidden="true">/</li>
          <li aria-current="page">{{ page_title }}</li>
        {%- endif -%}
      </ol>
    </div>
  </nav>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ 'general.breadcrumbs.home' | t | json }},
          "item": "{{ request.origin }}{{ routes.root_url }}"
        }
        {%- if template.name == 'product' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | default: 'All Products' | json }},
            "item": "{{ request.origin }}{{ collection.url | default: routes.all_products_collection_url }}"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ product.title | json }},
            "item": "{{ request.origin }}{{ product.url }}"
          }
        {%- elsif template.name == 'collection' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": "{{ request.origin }}{{ collection.url }}"
          }
        {%- elsif template.name == 'page' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ page.title | json }},
            "item": "{{ request.origin }}{{ page.url }}"
          }
        {%- endif -%}
      ]
    }
  </script>
{%- endunless -%}
