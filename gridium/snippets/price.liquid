{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant | default: product
  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 8500
  assign on_sale = false
  if compare_at_price and compare_at_price > price
    assign on_sale = true
    assign save_pct = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round
  endif
-%}
<span class="price{% if on_sale %} price--on-sale{% endif %}">
  <span class="price__regular">{{ price | money }}</span>
  {%- if on_sale -%}
    <s class="price__compare">{{ compare_at_price | money }}</s>
    {%- if show_badge -%}
      <span class="badge badge--sale">{{ 'products.product.sale_save' | t: percent: save_pct }}</span>
    {%- endif -%}
  {%- endif -%}
</span>
