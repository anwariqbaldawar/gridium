<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.paper_bg }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ shop.name }} &ndash; {{ 'general.password.title' | t }}</title>
    {% render 'meta-tags' %}
    {% render 'color-scheme-vars' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
    <script>document.documentElement.classList.replace('no-js', 'js');</script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>
  <body class="gridium-body color-paper template-password">
    <a class="skip-to-content-link button" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>
    <main id="MainContent" class="password-main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
