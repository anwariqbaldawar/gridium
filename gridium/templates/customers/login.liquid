<div class="container customer-box">
  <div id="RecoverPasswordBox" hidden style="margin-bottom:40px;">
    <span class="mono-label">ACCOUNT RECOVERY</span>
    <h1 class="h2" style="margin-block:8px 12px;">{{ 'customer.reset_password.recover_title' | t }}</h1>
    <p class="text-muted" style="margin-bottom:20px;">{{ 'customer.reset_password.recover_subtext' | t }}</p>
    {%- form 'recover_customer_password' -%}
      {%- if form.errors -%}
        <div class="form-status form-status--error">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div style="display:grid;gap:16px;">
        <label class="field">
          <span class="field__label">{{ 'customer.login.email' | t }}</span>
          <input type="email" name="email" class="field__input" required autocomplete="email">
        </label>
        <div style="display:flex;gap:12px;align-items:center;">
          <button type="submit" class="button">{{ 'contact.form.send' | t }}</button>
          <button type="button" class="button button--secondary" onclick="document.getElementById('RecoverPasswordBox').hidden=true;document.getElementById('CustomerLoginBox').hidden=false;">{{ 'customer.addresses.cancel' | t }}</button>
        </div>
      </div>
    {%- endform -%}
  </div>

  <div id="CustomerLoginBox">
    <span class="mono-label">01 / CLIENT PORTAL</span>
    <h1 class="h2" style="margin-block:8px 24px;">{{ 'customer.login.title' | t }}</h1>

    {%- form 'customer_login' -%}
      {%- if form.errors -%}
        <div class="form-status form-status--error">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div style="display:grid;gap:16px;">
        <label class="field">
          <span class="field__label">{{ 'customer.login.email' | t }}</span>
          <input type="email" name="customer[email]" class="field__input" required autocomplete="email">
        </label>
        <label class="field">
          <span class="field__label">{{ 'customer.login.password' | t }}</span>
          <input type="password" name="customer[password]" class="field__input" required autocomplete="current-password">
        </label>
        <div style="display:flex;justify-content:space-between;align-items:center;">
          <button type="button" class="mono-label link-underline" style="background:none;border:0;cursor:pointer;" onclick="document.getElementById('CustomerLoginBox').hidden=true;document.getElementById('RecoverPasswordBox').hidden=false;">
            {{ 'customer.login.forgot_password' | t }}
          </button>
          <a href="{{ routes.account_register_url }}" class="mono-label link-underline">{{ 'customer.login.create_account' | t }}</a>
        </div>
        <button type="submit" class="button button--full">{{ 'customer.login.sign_in' | t }}</button>
      </div>
    {%- endform -%}

    {%- if shop.checkout.guest_login -%}
      <div style="margin-top:32px;padding-top:24px;border-top:1px solid var(--color-border);">
        <h2 class="h4" style="margin-bottom:12px;">{{ 'customer.login.guest_title' | t }}</h2>
        {%- form 'guest_login' -%}
          <button type="submit" class="button button--secondary button--full">{{ 'customer.login.guest_continue' | t }}</button>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</div>
