<div class="container customer-box">
  <span class="mono-label">01 / SECURITY</span>
  <h1 class="h2" style="margin-block:8px 12px;">{{ 'customer.reset_password.title' | t }}</h1>
  <p class="text-muted" style="margin-bottom:24px;">{{ 'customer.reset_password.subtext' | t: email: email }}</p>

  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}
      <div class="form-status form-status--error">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div style="display:grid;gap:16px;">
      <label class="field">
        <span class="field__label">{{ 'customer.reset_password.password' | t }}</span>
        <input type="password" name="customer[password]" class="field__input" required>
      </label>
      <label class="field">
        <span class="field__label">{{ 'customer.reset_password.password_confirm' | t }}</span>
        <input type="password" name="customer[password_confirmation]" class="field__input" required>
      </label>
      <button type="submit" class="button button--full">{{ 'customer.reset_password.submit' | t }}</button>
    </div>
  {%- endform -%}
</div>
