<div class="container customer-wide">
  <div class="section-header">
    <div>
      <a href="{{ routes.account_url }}" class="mono-label link-underline">&larr; {{ 'customer.account.return' | t }}</a>
      <h1 class="h2" style="margin-top:10px;">{{ 'customer.addresses.title' | t }}</h1>
    </div>
    <button type="button" class="button button--sm" onclick="document.getElementById('AddAddressBox').hidden = !document.getElementById('AddAddressBox').hidden;">
      {{ 'customer.addresses.add_new' | t }}
    </button>
  </div>

  <div id="AddAddressBox" hidden style="border:1px solid var(--color-border);padding:24px;margin-bottom:32px;max-width:600px;">
    <h2 class="h4" style="margin-bottom:16px;">{{ 'customer.addresses.add_new' | t }}</h2>
    {%- form 'customer_address', customer.new_address -%}
      <div style="display:grid;gap:14px;">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <input type="text" name="address[first_name]" class="field__input" placeholder="{{ 'customer.addresses.first_name' | t }}" value="{{ form.first_name }}">
          <input type="text" name="address[last_name]" class="field__input" placeholder="{{ 'customer.addresses.last_name' | t }}" value="{{ form.last_name }}">
        </div>
        <input type="text" name="address[address1]" class="field__input" placeholder="{{ 'customer.addresses.address1' | t }}" value="{{ form.address1 }}" required>
        <input type="text" name="address[address2]" class="field__input" placeholder="{{ 'customer.addresses.address2' | t }}" value="{{ form.address2 }}">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <input type="text" name="address[city]" class="field__input" placeholder="{{ 'customer.addresses.city' | t }}" value="{{ form.city }}" required>
          <input type="text" name="address[zip]" class="field__input" placeholder="{{ 'customer.addresses.zip' | t }}" value="{{ form.zip }}" required>
        </div>
        <select name="address[country]" class="field__select" data-default="{{ form.country }}">{{ all_country_option_tags }}</select>
        <input type="tel" name="address[phone]" class="field__input" placeholder="{{ 'customer.addresses.phone' | t }}" value="{{ form.phone }}">
        <label class="facet-checkbox">{{ form.set_as_default_checkbox }}<span>{{ 'customer.addresses.set_default' | t }}</span></label>
        <button type="submit" class="button">{{ 'customer.addresses.add' | t }}</button>
      </div>
    {%- endform -%}
  </div>

  {%- paginate customer.addresses by 6 -%}
    <div class="testimonials-grid">
      {%- for address in customer.addresses -%}
        <div class="testimonial-card">
          <div>
            {%- if address == customer.default_address -%}
              <span class="badge" style="margin-bottom:10px;">{{ 'customer.addresses.default' | t }}</span>
            {%- endif -%}
            <div class="text-muted">{{ address | format_address }}</div>
          </div>
          <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}">
            <input type="hidden" name="_method" value="delete">
            <button type="submit" class="button button--secondary button--sm">{{ 'customer.addresses.delete' | t }}</button>
          </form>
        </div>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>
