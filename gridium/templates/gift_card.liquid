{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_cards.issued.title' | t }} &ndash; {{ shop.name }}</title>
    {% render 'color-scheme-vars' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="gridium-body color-paper">
    <main class="container section-pad" style="max-width:600px;text-align:center;display:grid;gap:24px;">
      <span class="site-header__logo" style="justify-self:center;">{{ shop.name }}</span>
      <span class="mono-label">DIGITAL ARCHIVE CREDIT</span>
      <h1 class="h2">{{ 'gift_cards.issued.title' | t }}</h1>
      <p class="text-muted">{{ 'gift_cards.issued.subtext' | t }}</p>

      <div style="border:1px solid var(--color-border);padding:36px 24px;background:var(--color-bg-subtle);display:grid;gap:16px;">
        {%- assign formatted_balance = gift_card.balance | money -%}
        <p class="h1">{{ formatted_balance }}</p>
        {%- if gift_card.expired -%}
          <span class="badge badge--sale" style="justify-self:center;">{{ 'gift_cards.issued.expired' | t }}</span>
        {%- elsif gift_card.expires_on -%}
          {%- assign exp_date = gift_card.expires_on | date: '%B %e, %Y' -%}
          <span class="mono-label">{{ 'gift_cards.issued.expires_on' | t: expires: exp_date }}</span>
        {%- endif -%}
        <code id="GiftCardDigits" style="font-family:var(--font-mono-family);font-size:1.25rem;letter-spacing:0.12em;padding:12px;border:1px dashed var(--color-text);background:var(--color-bg);">{{ gift_card.code | format_code }}</code>
      </div>

      <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:12px;">
        <button type="button" class="button" onclick="navigator.clipboard.writeText('{{ gift_card.code }}');this.textContent='{{ 'gift_cards.issued.code_copied' | t }}';">
          {{ 'gift_cards.issued.copy_code' | t }}
        </button>
        <button type="button" class="button button--secondary" onclick="window.print();">
          {{ 'gift_cards.issued.print' | t }}
        </button>
        <a href="{{ shop.url }}" class="button button--secondary">{{ 'gift_cards.issued.shop_link' | t }}</a>
      </div>

      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}" class="mono-label link-underline" style="justify-self:center;">{{ 'gift_cards.issued.add_to_apple_wallet' | t }}</a>
      {%- endif -%}
    </main>
  </body>
</html>
