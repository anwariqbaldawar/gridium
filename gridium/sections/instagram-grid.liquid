<section class="section-pad section-border-bottom color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="section-header__titles">
        <span class="mono-label">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.handle_label != blank -%}
        <a href="{{ settings.social_instagram_link | default: routes.all_products_collection_url }}" class="mono-label link-underline" style="color:var(--color-text);">
          {{ section.settings.handle_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="ig-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="ig-item" {{ block.shopify_attributes }} data-reveal aria-label="{{ block.settings.caption | escape }}">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 700 | image_tag: widths: '320, 500, 700', sizes: '(min-width: 768px) 25vw, 50vw', loading: 'lazy', alt: block.settings.caption }}
          {%- else -%}
            {%- capture ph -%}product-{{ forloop.index | modulo: 6 | plus: 1 }}{%- endcapture -%}
            {{ ph | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Visual archive grid",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "paper",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Mono meta label", "default": "07 / UNIFORM INDEX" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "In Daily Rotation" },
    { "type": "text", "id": "handle_label", "label": "Account label", "default": "@GRIDIUM.STUDIO" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Image tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Alt description", "default": "Gridium shirting lookbook" },
        { "type": "url", "id": "link", "label": "Optional link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Visual archive grid",
      "blocks": [{ "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }]
    }
  ]
}
{% endschema %}
