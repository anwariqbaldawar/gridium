{% render 'breadcrumbs' %}

<section class="section-pad section-border-bottom color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="grid-12 split-5-7">
      <div style="display:grid;gap:24px;align-content:start;">
        <div>
          <span class="mono-label">{{ section.settings.eyebrow }}</span>
          <h1 style="margin-top:8px;">{{ section.settings.heading }}</h1>
        </div>
        <p class="text-muted">{{ section.settings.intro }}</p>

        <div style="border-top:1px solid var(--color-border);padding-top:20px;display:grid;gap:16px;">
          <div>
            <span class="mono-label">CLIENT SERVICE</span>
            <p style="margin-top:4px;">{{ section.settings.email }}</p>
          </div>
          <div>
            <span class="mono-label">STUDIO ADDRESS</span>
            <p class="text-muted" style="margin-top:4px;white-space:pre-line;">{{ section.settings.address }}</p>
          </div>
          <div>
            <span class="mono-label">HOURS</span>
            <p class="text-muted" style="margin-top:4px;">{{ section.settings.hours }}</p>
          </div>
        </div>
      </div>

      <div style="border:1px solid var(--color-border);padding:clamp(24px,4vw,44px);">
        {%- form 'contact', id: 'StudioContactForm' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-status form-status--success" tabindex="-1" autofocus role="status">
              {{ 'contact.form.post_success' | t }}
            </p>
          {%- elsif form.errors -%}
            <div class="form-status form-status--error" role="alert" tabindex="-1" autofocus>
              <p>{{ 'contact.form.error_heading' | t }}</p>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div style="display:grid;gap:18px;">
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;">
              <label class="field">
                <span class="field__label">{{ 'contact.form.name' | t }} *</span>
                <input type="text" name="contact[name]" class="field__input" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" required autocomplete="name">
              </label>

              <label class="field">
                <span class="field__label">{{ 'contact.form.email' | t }} *</span>
                <input type="email" name="contact[email]" class="field__input" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" required autocomplete="email">
              </label>
            </div>

            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;">
              <label class="field">
                <span class="field__label">{{ 'contact.form.phone' | t }}</span>
                <input type="tel" name="contact[phone]" class="field__input" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" autocomplete="tel">
              </label>

              <label class="field">
                <span class="field__label">{{ 'contact.form.order_number' | t }}</span>
                <input type="text" name="contact[order_number]" class="field__input" placeholder="#GRD-1042">
              </label>
            </div>

            <label class="field">
              <span class="field__label">{{ 'contact.form.message' | t }} *</span>
              <textarea name="contact[body]" class="field__textarea" required>{{ form.body }}</textarea>
            </label>

            <div>
              <button type="submit" class="button">{{ 'contact.form.send' | t }}</button>
            </div>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact split form",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "paper",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Mono meta label", "default": "01 / CLIENT CONCIERGE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact the Studio" },
    { "type": "textarea", "id": "intro", "label": "Intro text", "default": "For garment measurement advice, fabric inquiries, press pulls, or existing order assistance, write directly to our New York shirting desk." },
    { "type": "text", "id": "email", "label": "Email", "default": "concierge@gridiumstudio.com" },
    { "type": "textarea", "id": "address", "label": "Address", "default": "48 Mercer Street, Floor 3\nNew York, NY 10013" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Monday – Friday, 09:00 – 18:00 EST" }
  ],
  "presets": [{ "name": "Contact split form" }]
}
{% endschema %}
