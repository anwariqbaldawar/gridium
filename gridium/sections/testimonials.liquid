<section class="section-pad section-border-bottom color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="section-header__titles">
        {%- if section.settings.eyebrow != blank -%}<span class="mono-label">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>

    <div class="testimonials-grid">
      {%- for block in section.blocks -%}
        <blockquote class="testimonial-card" style="margin:0;" {{ block.shopify_attributes }} data-reveal>
          <div style="display:grid;gap:16px;">
            <div style="display:flex;gap:4px;" aria-label="{{ 'accessibility.star_rating' | t: rating: 5 }}">
              {%- for i in (1..5) -%}{% render 'icon', name: 'star', size: 14 %}{%- endfor -%}
            </div>
            <p style="font-size:1.0625rem;line-height:1.55;">&ldquo;{{ block.settings.quote }}&rdquo;</p>
          </div>
          <footer style="border-top:1px solid var(--color-border);padding-top:14px;display:flex;justify-content:space-between;gap:12px;">
            <span style="font-weight:500;font-size:0.875rem;">{{ block.settings.author }}</span>
            <span class="mono-label">{{ block.settings.garment }}</span>
          </footer>
        </blockquote>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "paper",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Mono meta label", "default": "06 / CLIENT NOTES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Worn & Reviewed" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The collar roll on the Mercer Oxford rivals custom shirts twice its price. Washes cleanly and holds its architectural shoulder line." },
        { "type": "text", "id": "author", "label": "Client name & city", "default": "Marcus V. — Zurich" },
        { "type": "text", "id": "garment", "label": "Shirt worn", "default": "SIZE L / OXFORD" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "review", "settings": { "quote": "The collar roll on the Mercer Oxford rivals bespoke shirts twice its price. Holds a crisp architectural shoulder line all day.", "author": "Marcus V. — Zurich", "garment": "SIZE L / OXFORD" } },
        { "type": "review", "settings": { "quote": "Finally a heavyweight white T-shirt that is completely opaque, drapes cleanly off the chest, and never twists at the side seams.", "author": "Daniel K. — London", "garment": "SIZE M / 240 GSM TEE" } },
        { "type": "review", "settings": { "quote": "Took two Belgian Linen Camp Shirts to Lisbon. Breathable in 32°C heat with an understated, tailored drape for dinner.", "author": "Henrik S. — Copenhagen", "garment": "SIZE L / LINEN" } }
      ]
    }
  ]
}
{% endschema %}
