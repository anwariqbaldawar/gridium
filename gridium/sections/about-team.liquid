{%- liquid
  assign member_blocks = section.blocks | where: 'type', 'member'
-%}

<section class="about-team section-pad section-border-bottom color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="section-header__titles">
        <span class="mono-label">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.intro != blank -%}
          <p class="text-muted text-small" style="max-width:52ch;">{{ section.settings.intro }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.note != blank -%}
        <p class="spec-row__item">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>

    <div class="team-grid">
      {%- for block in member_blocks -%}
        <article class="team-card" data-reveal data-reveal-delay="{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="team-card__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  widths: '320, 480, 700, 900',
                  sizes: '(min-width: 1024px) 31vw, (min-width: 640px) 48vw, 100vw',
                  loading: 'lazy',
                  class: 'team-card__img',
                  alt: block.settings.name
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg team-card__img' }}
            {%- endif -%}
            <span class="team-card__index">0{{ forloop.index }}</span>
          </div>
          <div class="team-card__body">
            <span class="mono-label team-card__role">{{ block.settings.role }}</span>
            <h3 class="team-card__name">{{ block.settings.name }}</h3>
            {%- if block.settings.bio != blank -%}
              <p class="team-card__bio">{{ block.settings.bio }}</p>
            {%- endif -%}
            {%- if block.settings.link != blank and block.settings.link_label != blank -%}
              <a href="{{ block.settings.link }}" class="link-arrow team-card__link">
                {{ block.settings.link_label }}
                {% render 'icon', name: 'arrow-right', size: 13 %}
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_heading != blank -%}
      <div class="about-team__cta" data-reveal>
        <div class="about-team__cta-copy">
          <span class="mono-label">{{ section.settings.cta_eyebrow }}</span>
          <h3 class="h2">{{ section.settings.cta_heading }}</h3>
        </div>
        <div class="about-team__cta-actions">
          <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="button">
            {{ section.settings.cta_label }}
            {% render 'icon', name: 'arrow-right', size: 15 %}
          </a>
          {%- if section.settings.cta_secondary_label != blank -%}
            <a href="{{ section.settings.cta_secondary_link | default: '/pages/contact' }}" class="button button--secondary">
              {{ section.settings.cta_secondary_label }}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>



{% schema %}
{
  "name": "About team & CTA",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "paper",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Mono meta label", "default": "06 / THE PEOPLE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Patternmakers, weavers, and one very patient machinist." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Eleven people work on the Gridium catalogue. These are the four who sign off on a shirt before it ships." },
    { "type": "text", "id": "note", "label": "Right meta note", "default": "TEAM: 11 · ATELIER: PORTO + NEW YORK" },
    { "type": "text", "id": "cta_eyebrow", "label": "CTA meta label", "default": "NEXT STEP" },
    { "type": "text", "id": "cta_heading", "label": "Bottom CTA heading", "default": "Inspect the current shirting collection." },
    { "type": "text", "id": "cta_label", "label": "CTA button label", "default": "Explore all shirts" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary button label", "default": "Talk to the studio" },
    { "type": "url", "id": "cta_secondary_link", "label": "Secondary button link" }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Team member",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Portrait" },
        { "type": "text", "id": "role", "label": "Role", "default": "HEAD OF PATTERN ARCHITECTURE" },
        { "type": "text", "id": "name", "label": "Name", "default": "Lukas Lindqvist" },
        { "type": "textarea", "id": "bio", "label": "Short bio", "default": "18 years drafting bespoke and ready-to-wear shirting blocks across Stockholm and Porto." },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "About team & CTA" }]
}
{% endschema %}
