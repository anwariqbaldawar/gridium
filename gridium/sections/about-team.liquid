<section class="section-pad section-border-bottom color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="section-header__titles">
        <span class="mono-label">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>

    <div class="testimonials-grid">
      {%- for block in section.blocks -%}
        <article class="product-card" {{ block.shopify_attributes }} data-reveal>
          <div class="product-card__media-wrap">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 700 | image_tag: widths: '350, 700', sizes: '(min-width: 768px) 33vw, 100vw', loading: 'lazy', class: 'product-card__img', alt: block.settings.name }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div style="display:grid;gap:4px;">
            <span class="mono-label">{{ block.settings.role }}</span>
            <h3 class="h4">{{ block.settings.name }}</h3>
            <p class="text-muted" style="font-size:0.875rem;">{{ block.settings.bio }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_heading != blank -%}
      <div style="margin-top:64px;padding:clamp(28px,4vw,48px);border:1px solid var(--color-border);display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px;" data-reveal>
        <div>
          <span class="mono-label">ARCHIVE ACCESS</span>
          <h3 class="h2" style="margin-top:6px;">{{ section.settings.cta_heading }}</h3>
        </div>
        <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="button">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About team & CTA",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "paper",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Mono meta label", "default": "04 / ATELIER LEADERSHIP" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Patternmakers & Textile Leads" },
    { "type": "text", "id": "cta_heading", "label": "Bottom CTA heading", "default": "Inspect the Current Shirting Collection" },
    { "type": "text", "id": "cta_label", "label": "CTA button label", "default": "Explore All Shirts" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Team member",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Portrait" },
        { "type": "text", "id": "role", "label": "Role", "default": "HEAD OF PATTERN ARCHITECTURE" },
        { "type": "text", "id": "name", "label": "Name", "default": "Lukas Lindqvist" },
        { "type": "textarea", "id": "bio", "label": "Short bio", "default": "18 years drafting bespoke and ready-to-wear shirting blocks across Stockholm and Porto." }
      ]
    }
  ],
  "presets": [{ "name": "About team & CTA" }]
}
{% endschema %}
