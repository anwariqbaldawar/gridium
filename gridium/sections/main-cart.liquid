{%- liquid
  assign threshold_cents = settings.cart_free_shipping_threshold | default: 150 | times: 100
  assign remaining = threshold_cents | minus: cart.total_price
  if threshold_cents > 0
    assign progress = cart.total_price | times: 100.0 | divided_by: threshold_cents
    if progress > 100
      assign progress = 100
    endif
  endif
-%}

<section class="section-pad color-{{ section.settings.color_scheme }}" data-main-cart-section>
  <div class="container">
    <div class="section-header">
      <div class="section-header__titles">
        <span class="mono-label">01 / SHOPPING BAG</span>
        <h1>{{ 'cart.title' | t }} ({{ cart.item_count }})</h1>
      </div>
      <a href="{{ routes.all_products_collection_url }}" class="mono-label link-underline" style="color:var(--color-text);">{{ 'cart.continue_shopping' | t }}</a>
    </div>

    {%- if cart == empty -%}
      <div class="cart-empty" style="border:1px solid var(--color-border);">
        <h2 class="h3">{{ 'cart.empty_title' | t }}</h2>
        <p class="text-muted">{{ 'cart.empty_text' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'cart.continue_shopping' | t }}</a>
      </div>
    {%- else -%}
      <div class="cart-page-grid">
        <div>
          {%- if threshold_cents > 0 -%}
            <div class="cart-shipping-bar" style="border:1px solid var(--color-border);margin-bottom:24px;">
              {%- if remaining <= 0 -%}
                <span>{{ 'cart.free_shipping_unlocked' | t }}</span>
              {%- else -%}
                {%- assign rem_money = remaining | money -%}
                <span>{{ 'cart.free_shipping_remaining_html' | t: amount: rem_money }}</span>
              {%- endif -%}
              <div class="cart-shipping-bar__track">
                <div class="cart-shipping-bar__fill" style="width: {{ progress | round }}%;"></div>
              </div>
            </div>
          {%- endif -%}

          <div class="cart-items-list">
            {%- for item in cart.items -%}
              {% render 'cart-item', item: item, line_index: forloop.index %}
            {%- endfor -%}
          </div>
        </div>

        <aside class="cart-summary-card">
          {%- if settings.cart_show_note -%}
            <label class="field">
              <span class="field__label">{{ 'cart.note_label' | t }}</span>
              <textarea class="field__textarea" style="min-height:84px;" data-cart-note placeholder="{{ 'cart.note_placeholder' | t }}">{{ cart.note }}</textarea>
            </label>
          {%- endif -%}

          <div class="cart-subtotal-row">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money_with_currency }}</span>
          </div>
          <p class="text-muted" style="font-size:0.8125rem;">{{ 'cart.taxes_and_shipping' | t }}</p>

          <form action="{{ routes.cart_url }}" method="post">
            <button type="submit" name="checkout" class="button button--full">{{ 'cart.checkout' | t }}</button>
          </form>
        </aside>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Main cart",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "paper",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    }
  ]
}
{% endschema %}
