{% render 'breadcrumbs' %}

<section class="blog-index color-{{ section.settings.color_scheme }}">
  <div class="container">
    <header class="blog-index__head">
      <div data-reveal>
        <span class="eyebrow">{{ section.settings.eyebrow | default: 'THE GRIDIUM JOURNAL' }}</span>
        <h1 class="display-xl blog-index__title">{{ blog.title }}</h1>
      </div>
      <div class="blog-index__intro" data-reveal data-reveal-delay="1">
        {%- if section.settings.intro != blank -%}
          <p class="text-lead">{{ section.settings.intro }}</p>
        {%- elsif blog.description != blank -%}
          <div class="rte text-lead">{{ blog.description }}</div>
        {%- endif -%}
      </div>
    </header>

    {%- if blog.all_tags.size > 0 and section.settings.show_tags -%}
      <nav class="blog-index__tags" aria-label="{{ 'blogs.all_tags' | t }}" data-reveal>
        <a href="{{ blog.url }}" class="chip{% unless current_tags %} chip--solid{% endunless %}">All</a>
        {%- for tag in blog.all_tags -%}
          <a
            href="{{ blog.url }}/tagged/{{ tag | handle }}"
            class="chip{% if current_tags contains tag %} chip--solid{% endif %}"
          >{{ tag }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- paginate blog.articles by section.settings.articles_per_page -%}
      {%- if blog.articles.size == 0 -%}
        <p class="blog-index__empty text-muted">{{ 'blogs.no_articles' | t }}</p>
      {%- else -%}
        {%- assign featured_article = blog.articles.first -%}
        {%- if section.settings.show_featured and paginate.current_page == 1 and current_tags == blank -%}
          <div class="blog-index__featured">
            {% render 'article-card', article: featured_article, featured: true %}
          </div>
          {%- assign remaining = blog.articles | slice: 1, 24 -%}
        {%- else -%}
          {%- assign remaining = blog.articles -%}
        {%- endif -%}

        {%- if remaining.size > 0 -%}
          <div class="article-grid">
            {%- for article in remaining -%}
              {% render 'article-card', article: article %}
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}

      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Journal grid",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "paper",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Mono meta label", "default": "01 / THE GRIDIUM JOURNAL" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Mill notes, pattern revisions and the occasional argument about collar roll. Written by the people who make the shirts." },
    { "type": "checkbox", "id": "show_featured", "label": "Feature the newest story", "default": true },
    { "type": "checkbox", "id": "show_tags", "label": "Show topic filters", "default": true },
    { "type": "range", "id": "articles_per_page", "min": 4, "max": 24, "step": 2, "label": "Stories per page", "default": 10 }
  ],
  "presets": [{ "name": "Journal grid" }]
}
{% endschema %}
