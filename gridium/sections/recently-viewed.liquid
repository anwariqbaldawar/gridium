<section class="section-pad section-border-bottom color-{{ section.settings.color_scheme }}" data-recently-viewed data-exclude-handle="{{ product.handle }}" hidden>
  <div class="container">
    <div class="section-header">
      <div class="section-header__titles">
        <span class="mono-label">03 / VIEWED HISTORY</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>
    <div class="product-grid product-grid--4" data-recently-grid></div>
  </div>
</section>

{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "paper",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently Inspected" }
  ],
  "presets": [{ "name": "Recently viewed" }]
}
{% endschema %}
