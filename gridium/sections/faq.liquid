<section class="section-pad section-border-bottom color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="grid-12 split-4-8">
      <div style="display:grid;gap:10px;align-content:start;">
        <span class="mono-label">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p class="text-muted">{{ section.settings.subtext }}</p>
      </div>

      <div>
        {%- for block in section.blocks -%}
          <details class="accordion-item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="accordion-summary">
              <span>{{ block.settings.question }}</span>
              {% render 'icon', name: 'plus', size: 16 %}
            </summary>
            <div class="accordion-content rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ accordion",
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "stone",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Mono meta label", "default": "02 / FREQUENTLY ASKED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sizing, Care & Dispatch" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Clear answers on shirting shrinkage, collar construction, and exchanges." }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Do Gridium shirts shrink after washing?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>All cotton jersey and Oxford fabrics are pre-shrunk at the mill. Expect less than 1.5% tolerance when washed cold and hung dry.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ accordion" }]
}
{% endschema %}
