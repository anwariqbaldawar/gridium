{%- liquid
  assign stat_blocks = section.blocks | where: 'type', 'stat'
-%}

<section class="about-hero color-{{ section.settings.color_scheme }}">
  <div class="container about-hero__inner">
    <div class="about-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="display-xl about-hero__title" data-reveal data-reveal-delay="1">
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank -%}
          <span class="about-hero__accent">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
      </h1>

      {%- if section.settings.lead != blank -%}
        <p class="text-lead about-hero__lead" data-reveal data-reveal-delay="2">{{ section.settings.lead }}</p>
      {%- endif -%}

      <div class="about-hero__actions" data-reveal data-reveal-delay="3">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button">
            {{ section.settings.button_label }}
            {% render 'icon', name: 'arrow-right', size: 15 %}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_link | default: '#about-manifesto' }}" class="button button--secondary">
            {{ section.settings.secondary_label }}
          </a>
        {%- endif -%}
      </div>
    </div>

    <figure class="about-hero__media" data-reveal-media data-reveal>
      <div class="about-hero__frame">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              widths: '480, 720, 1000, 1400',
              sizes: '(min-width: 1024px) 44vw, 100vw',
              loading: 'eager',
              alt: section.settings.image.alt | default: section.settings.heading
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      {%- if section.settings.card_heading != blank -%}
        <figcaption class="about-hero__card">
          <span class="mono-label">{{ section.settings.card_eyebrow }}</span>
          <p class="h4">{{ section.settings.card_heading }}</p>
          {%- if section.settings.card_meta != blank -%}
            <span class="spec-row__item">{{ section.settings.card_meta }}</span>
          {%- endif -%}
        </figcaption>
      {%- endif -%}
    </figure>
  </div>

  {%- if stat_blocks.size > 0 -%}
    <div class="container">
      <div class="about-stats">
        {%- for block in stat_blocks -%}
          <div class="about-stat" data-reveal data-reveal-delay="{{ forloop.index }}" {{ block.shopify_attributes }}>
            <span class="about-stat__value">{{ block.settings.number }}</span>
            <span class="about-stat__label">{{ block.settings.label }}</span>
            {%- if block.settings.caption != blank -%}
              <p class="about-stat__caption">{{ block.settings.caption }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "About — Editorial hero",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "paper",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Mono meta label", "default": "01 / THE HOUSE OF GRIDIUM" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "A shirting house built on" },
    { "type": "text", "id": "heading_accent", "label": "Headline accent (italic line)", "default": "measurement, not mood." },
    { "type": "textarea", "id": "lead", "label": "Lead paragraph", "default": "Gridium is an independent shirting atelier. We design and manufacture a deliberately small catalogue of Oxfords, poplins, linens and knits — each pattern revised over years, not seasons, with family-owned European mills we visit in person." },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop the Collection" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Read the manifesto" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "image_picker", "id": "image", "label": "Portrait / atelier image" },
    { "type": "text", "id": "card_eyebrow", "label": "Floating card label", "default": "ATELIER NOTE 001" },
    { "type": "text", "id": "card_heading", "label": "Floating card heading", "default": "Pattern table, Porto — 07:40" },
    { "type": "text", "id": "card_meta", "label": "Floating card meta", "default": "38 BLOCKS · 6 FITS · 1 STANDARD" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Metric",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "number", "label": "Value", "default": "22" },
        { "type": "text", "id": "label", "label": "Label", "default": "STITCHES PER INCH" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Single-needle lockstitch on every side seam." }
      ]
    }
  ],
  "presets": [
    {
      "name": "About — Editorial hero",
      "blocks": [
        { "type": "stat", "settings": { "number": "22", "label": "STITCHES PER INCH", "caption": "Single-needle lockstitch on every side seam." } },
        { "type": "stat", "settings": { "number": "4", "label": "MILL PARTNERS", "caption": "Portugal, Belgium, Italy and Japan — visited twice yearly." } },
        { "type": "stat", "settings": { "number": "2016", "label": "FOUNDED IN", "caption": "Started with a single Oxford block in a Brooklyn studio." } },
        { "type": "stat", "settings": { "number": "0%", "label": "PLASTIC PACKAGING", "caption": "FSC board, glassine and paper tape only." } }
      ]
    }
  ]
}
{% endschema %}
