{%- liquid
  assign material_blocks = section.blocks | where: 'type', 'material'
-%}

<section class="about-materials color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="section-header__titles">
        <span class="mono-label">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.view_all_label != blank -%}
        <a href="{{ section.settings.view_all_link | default: routes.all_products_collection_url }}" class="link-arrow">
          {{ section.settings.view_all_label }}
          {% render 'icon', name: 'arrow-right', size: 14 %}
        </a>
      {%- endif -%}
    </div>

    <div class="material-grid">
      {%- for block in material_blocks -%}
        <article class="material-card" data-reveal data-reveal-delay="{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="material-card__top">
            <span class="material-card__swatch" style="--swatch-color: {{ block.settings.swatch | default: '#D8D3C8' }};" aria-hidden="true"></span>
            <span class="section-index">0{{ forloop.index }}</span>
          </div>
          <h3 class="material-card__title">{{ block.settings.title }}</h3>
          <p class="material-card__description">{{ block.settings.description }}</p>
          <dl class="material-card__specs">
            {%- if block.settings.mill != blank -%}
              <div><dt>Mill</dt><dd>{{ block.settings.mill }}</dd></div>
            {%- endif -%}
            {%- if block.settings.weight != blank -%}
              <div><dt>Weight</dt><dd>{{ block.settings.weight }}</dd></div>
            {%- endif -%}
            {%- if block.settings.care != blank -%}
              <div><dt>Care</dt><dd>{{ block.settings.care }}</dd></div>
            {%- endif -%}
          </dl>
          {%- if block.settings.tag != blank -%}
            <span class="chip material-card__tag">{{ block.settings.tag }}</span>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="spec-row__item about-materials__footnote" data-reveal>{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About — Materials",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "paper",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Mono meta label", "default": "05 / THE MATERIAL LIBRARY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four fabrics. Chosen for how they age." },
    { "type": "text", "id": "view_all_label", "label": "Right link label", "default": "Shop by fabric" },
    { "type": "url", "id": "view_all_link", "label": "Right link URL" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "ALL FABRICS ARE CERTIFIED GOTS ORGANIC OR MASTERS OF LINEN® · MILL ORIGIN LISTED PER LOT" }
  ],
  "blocks": [
    {
      "type": "material",
      "name": "Material",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "Name", "default": "Two-ply Portuguese poplin" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "High-twist long-staple cotton with a dry, quiet hand. Holds a crease through a full day of meetings." },
        { "type": "text", "id": "mill", "label": "Mill", "default": "Somelos · PT" },
        { "type": "text", "id": "weight", "label": "Weight", "default": "130 GSM" },
        { "type": "text", "id": "care", "label": "Care", "default": "Cold wash · warm iron" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "OEKO-TEX® 100" },
        { "type": "color", "id": "swatch", "label": "Swatch", "default": "#EDEAE3" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About — Materials",
      "blocks": [
        { "type": "material", "settings": { "title": "Two-ply Portuguese poplin", "description": "High-twist long-staple cotton with a dry, quiet hand. Holds a crease through a full day of meetings.", "mill": "Somelos · PT", "weight": "130 GSM", "care": "Cold wash · warm iron", "tag": "OEKO-TEX® 100", "swatch": "#EDEAE3" } },
        { "type": "material", "settings": { "title": "Washed Oxford cloth", "description": "Basket-woven and garment-washed until the collar rolls unfused and soft. Our most reordered shirt.", "mill": "Albini · IT", "weight": "145 GSM", "care": "Machine wash · hang dry", "tag": "ORGANIC COTTON", "swatch": "#DCD9D1" } },
        { "type": "material", "settings": { "title": "Belgian flax linen", "description": "Rain-fed flax, wet-spun for a dry touch that softens with wear instead of thinning out.", "mill": "Libeco · BE", "weight": "165 GSM", "care": "Cold wash · line dry", "tag": "MASTERS OF LINEN®", "swatch": "#C9C6B9" } },
        { "type": "material", "settings": { "title": "240 GSM Supima jersey", "description": "Long-staple American Supima, compact-spun for opacity and a dense, structured drape.", "mill": "Kurabo · JP", "weight": "240 GSM", "care": "Cold wash · tumble low", "tag": "SUPIMA®", "swatch": "#F4F3EF" } }
      ]
    }
  ]
}
{% endschema %}
