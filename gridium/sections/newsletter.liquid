<section class="section-pad color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="grid-12 split-5-7" style="align-items:center;" data-reveal>
      <div style="display:grid;gap:12px;">
        <span class="mono-label">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p class="text-muted">{{ section.settings.subtext }}</p>
      </div>

      <div>
        {%- form 'customer', id: 'SectionNewsletterForm' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="form-status form-status--success" role="status">{{ 'general.newsletter.success' | t }}</p>
          {%- elsif form.errors -%}
            <p class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <div style="display:flex;flex-wrap:wrap;gap:10px;">
            <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'general.newsletter.label' | t }}</label>
            <input
              id="NewsletterEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              class="field__input"
              style="flex:1 1 240px;"
              value="{{ form.email }}"
              required
              placeholder="{{ 'general.newsletter.placeholder' | t }}"
            >
            <button type="submit" class="button">{{ 'general.newsletter.button' | t }}</button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "stone",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Mono meta label", "default": "08 / STUDIO DISPATCH" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Seasonal Mill Releases" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Early access to small-batch Italian poplins, Japanese chambrays, and archival restocks." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
