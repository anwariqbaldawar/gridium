{%- if section.blocks.size > 0 -%}
  <div class="announcement-bar color-{{ section.settings.color_scheme }}" data-announcement-rotator data-speed="{{ section.settings.rotation_speed }}">
    <div class="container announcement-bar__inner">
      {%- for block in section.blocks -%}
        <div class="announcement-bar__slide mono-label{% if forloop.first %} is-active{% endif %}" style="color:inherit;" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="link-underline">{{ block.settings.text }}</a>
          {%- else -%}
            <span>{{ block.settings.text }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 4,
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "midnight",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Rotation interval",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "COMPLIMENTARY SHIPPING ON ORDERS OVER $150" },
        { "type": "url", "id": "link", "label": "Optional link" }
      ]
    }
  ]
}
{% endschema %}
