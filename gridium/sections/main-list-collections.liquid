{% render 'breadcrumbs' %}

<section class="section-pad color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="section-header">
      <div class="section-header__titles">
        <span class="mono-label">01 / DIRECTORY</span>
        <h1>{{ section.settings.heading }}</h1>
      </div>
    </div>

    {%- paginate collections by 12 -%}
      <div class="collections-list-grid">
        {%- for col in collections -%}
          <a href="{{ col.url }}" class="collection-card" data-reveal>
            <div class="collection-card__media">
              {%- if col.featured_image != blank -%}
                {{ col.featured_image | image_url: width: 900 | image_tag: widths: '400, 640, 900', sizes: '(min-width: 1024px) 33vw, 100vw', loading: 'lazy', alt: col.title }}
              {%- else -%}
                {%- capture ph -%}collection-{{ forloop.index | modulo: 6 | plus: 1 }}{%- endcapture -%}
                {{ ph | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="collection-card__body">
              <h2 class="h4">{{ col.title }}</h2>
              <span class="mono-label">{{ 'collections.items_count' | t: count: col.all_products_count }}</span>
            </div>
          </a>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "paper",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shirting Collections" }
  ]
}
{% endschema %}
