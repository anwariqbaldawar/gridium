<section class="section-pad section-border-bottom color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="section-header__titles">
        {%- if section.settings.eyebrow != blank -%}<span class="mono-label">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.view_all_label != blank -%}
        <a href="{{ routes.collections_url }}" class="mono-label link-underline" style="color:var(--color-text);">{{ section.settings.view_all_label }}</a>
      {%- endif -%}
    </div>

    <div class="category-tiles-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col_obj = collections[block.settings.collection]
          assign tile_url = block.settings.link | default: col_obj.url | default: routes.all_products_collection_url
          assign tile_title = block.settings.title | default: col_obj.title | default: 'Shirting'
          assign span_class = 'category-tile--third'
          if block.settings.layout_span == 'wide'
            assign span_class = 'category-tile--wide'
          elsif block.settings.layout_span == 'narrow'
            assign span_class = 'category-tile--narrow'
          endif
        -%}
        <a href="{{ tile_url }}" class="category-tile {{ span_class }}" {{ block.shopify_attributes }} data-reveal data-reveal-delay="{{ forloop.index }}">
          <div class="category-tile__media" data-reveal-media>
            <span class="category-tile__index">0{{ forloop.index }}</span>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '480, 800, 1200', sizes: '(min-width: 768px) 50vw, 100vw', loading: 'lazy', alt: tile_title }}
            {%- elsif col_obj.featured_image != blank -%}
              {{ col_obj.featured_image | image_url: width: 1200 | image_tag: widths: '480, 800, 1200', sizes: '(min-width: 768px) 50vw, 100vw', loading: 'lazy', alt: tile_title }}
            {%- else -%}
              {%- capture ph -%}collection-{{ forloop.index | modulo: 4 | plus: 1 }}{%- endcapture -%}
              {{ ph | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="category-tile__meta">
            <div>
              <span class="mono-label">{{ block.settings.meta_code }}</span>
              <h3 class="h4" style="margin-top:4px;">{{ tile_title }}</h3>
            </div>
            {% render 'icon', name: 'arrow-right', size: 18 %}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category tiles",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "paper",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Mono meta label", "default": "02 / SILHOUETTES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "text", "id": "view_all_label", "label": "Link label", "default": "All Categories" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image" },
        { "type": "text", "id": "meta_code", "label": "Mono tag", "default": "01 / CRISP WEAVE" },
        { "type": "text", "id": "title", "label": "Title", "default": "Oxford & Casual Shirts" },
        { "type": "url", "id": "link", "label": "Custom link override" },
        {
          "type": "select",
          "id": "layout_span",
          "label": "Desktop grid width",
          "default": "wide",
          "options": [
            { "value": "wide", "label": "7 columns (Wide)" },
            { "value": "narrow", "label": "5 columns (Narrow)" },
            { "value": "third", "label": "4 columns (One-third)" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "meta_code": "01 / EVERYDAY TAILORING", "title": "Oxford & Casual Shirts", "layout_span": "wide" } },
        { "type": "tile", "settings": { "meta_code": "02 / 240 GSM SUPIMA", "title": "Heavyweight T-Shirts", "layout_span": "narrow" } },
        { "type": "tile", "settings": { "meta_code": "03 / BELGIAN FLAX", "title": "Linen & Resort Shirts", "layout_span": "third" } },
        { "type": "tile", "settings": { "meta_code": "04 / TWO-PLY POPLIN", "title": "Formal Dress Shirts", "layout_span": "third" } },
        { "type": "tile", "settings": { "meta_code": "05 / KNIT PIQUE & INTERLOCK", "title": "Architectural Polos", "layout_span": "third" } }
      ]
    }
  ]
}
{% endschema %}
