{% render 'breadcrumbs' %}

<section class="section-pad color-{{ section.settings.color_scheme }}" data-wishlist-page>
  <div class="container">
    <div class="section-header">
      <div class="section-header__titles">
        <span class="mono-label">01 / PERSONAL SHORTLIST</span>
        <h1>{{ 'products.wishlist.title' | t }}</h1>
        <p class="text-muted">{{ 'products.wishlist.subtitle' | t }}</p>
      </div>
    </div>

    <div class="product-grid product-grid--4" data-wishlist-grid></div>

    <div class="collection-empty" style="border:1px solid var(--color-border);" data-wishlist-empty hidden>
      <h2 class="h3">{{ 'products.wishlist.empty_title' | t }}</h2>
      <p class="text-muted">{{ 'products.wishlist.empty_text' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'products.wishlist.continue_shopping' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wishlist grid",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "paper",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    }
  ]
}
{% endschema %}
