<footer class="site-footer color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="{{ routes.root_url }}" class="site-header__logo">{{ shop.name | default: 'GRIDIUM' }}</a>
        <p class="text-muted" style="font-size:0.9375rem;max-width:34ch;">{{ section.settings.brand_tagline }}</p>
        {% render 'social-icons' %}
      </div>

      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <span class="mono-label">{{ block.settings.heading }}</span>
          {%- case block.type -%}
            {%- when 'link_list' -%}
              {%- assign f_menu = linklists[block.settings.menu] -%}
              <ul class="site-footer__links">
                {%- if f_menu != blank and f_menu.links.size > 0 -%}
                  {%- for link in f_menu.links -%}
                    <li><a href="{{ link.url }}" class="link-underline">{{ link.title }}</a></li>
                  {%- endfor -%}
                {%- else -%}
                  <li><a href="{{ routes.all_products_collection_url }}" class="link-underline">{{ 'collections.all_products' | t }}</a></li>
                  <li><a href="{{ routes.collections_url }}" class="link-underline">{{ 'general.breadcrumbs.collections' | t }}</a></li>
                  <li><a href="/pages/wishlist" class="link-underline">{{ 'products.wishlist.title' | t }}</a></li>
                {%- endif -%}
              </ul>
            {%- when 'studio_links' -%}
              <ul class="site-footer__links">
                <li><a href="/pages/about" class="link-underline">About Us</a></li>
                <li><a href="/pages/contact" class="link-underline">Contact Studio</a></li>
                <li><a href="/pages/privacy-policy" class="link-underline">Privacy Policy</a></li>
                <li><a href="/pages/refund-policy" class="link-underline">Refund Policy</a></li>
              </ul>
            {%- when 'text' -%}
              <div class="site-footer__links text-muted" style="white-space:pre-line;">{{ block.settings.body }}</div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="site-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.copyright' | t }}</span>

      <div class="localization-bar">
        {%- if settings.enable_country_selector and localization.available_countries.size > 1 -%}
          {%- form 'localization', id: 'FooterCountryForm', data-localization-form: '' -%}
            <label class="visually-hidden" for="FooterCountrySelect">{{ 'general.localization.country_label' | t }}</label>
            <select id="FooterCountrySelect" name="country_code" class="localization-select">
              {%- for country in localization.available_countries -%}
                <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                  {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                </option>
              {%- endfor -%}
            </select>
          {%- endform -%}
        {%- endif -%}

        {%- if settings.enable_language_selector and localization.available_languages.size > 1 -%}
          {%- form 'localization', id: 'FooterLanguageForm', data-localization-form: '' -%}
            <label class="visually-hidden" for="FooterLanguageSelect">{{ 'general.localization.language_label' | t }}</label>
            <select id="FooterLanguageSelect" name="locale_code" class="localization-select">
              {%- for language in localization.available_languages -%}
                <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                  {{ language.endonym_name | capitalize }}
                </option>
              {%- endfor -%}
            </select>
          {%- endform -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "paper",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    },
    {
      "type": "textarea",
      "id": "brand_tagline",
      "label": "Brand statement",
      "default": "Architectural shirting engineered for order, longevity, and daily precision."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Navigation column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Mono heading", "default": "01 / SHIRTING" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "studio_links",
      "name": "Essential pages column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Mono heading", "default": "02 / CLIENT CARE" }
      ]
    },
    {
      "type": "text",
      "name": "Studio info",
      "settings": [
        { "type": "text", "id": "heading", "label": "Mono heading", "default": "03 / ATELIER" },
        { "type": "textarea", "id": "body", "label": "Details", "default": "48 Mercer Street, Floor 3\nNew York, NY 10013" }
      ]
    }
  ]
}
{% endschema %}
