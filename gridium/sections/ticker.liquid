{%- liquid
  assign ticker_items = section.settings.text | split: '|'
-%}

<section class="ticker color-{{ section.settings.color_scheme }}" aria-label="{{ section.settings.label }}">
  <div class="marquee" style="--marquee-duration: {{ section.settings.speed }}s;" aria-hidden="true">
    <div class="marquee__track">
      {%- for pass in (1..2) -%}
        {%- for item in ticker_items -%}
          {%- assign trimmed = item | strip -%}
          {%- if trimmed != blank -%}
            {%- if section.settings.link != blank -%}
              <a class="marquee__item" href="{{ section.settings.link }}">{{ trimmed }}</a>
            {%- else -%}
              <span class="marquee__item">{{ trimmed }}</span>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ticker strip",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "paper",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    },
    { "type": "text", "id": "label", "label": "Accessible label", "default": "Store promises" },
    { "type": "text", "id": "text", "label": "Ticker text (separate with |)", "default": "Complimentary shipping over $150|30-day exchanges|22 stitches per inch|Mill-first sourcing|Plastic-free packaging|Repairs for a decade" },
    { "type": "url", "id": "link", "label": "Optional link" },
    { "type": "range", "id": "speed", "min": 20, "max": 80, "step": 5, "unit": "s", "label": "Loop duration", "default": 45 }
  ],
  "presets": [{ "name": "Ticker strip" }]
}
{% endschema %}
