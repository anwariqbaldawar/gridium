{% render 'breadcrumbs' %}

<section class="section-pad color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div style="max-width:680px;margin-bottom:40px;">
      <span class="mono-label">01 / SEARCH</span>
      <h1 style="margin-block:8px 20px;">{{ 'general.search.title' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:10px;">
        <input type="search" name="q" value="{{ search.terms | escape }}" class="field__input" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.title' | t }}">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="button">{{ 'general.search.submit' | t }}</button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- paginate search.results by 12 -%}
        {%- if search.results_count == 0 -%}
          <div class="collection-empty" style="border:1px solid var(--color-border);">
            <p class="h4">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'collections.all_products' | t }}</a>
          </div>
        {%- else -%}
          <p class="mono-label" style="margin-bottom:24px;">{{ 'general.search.results_with_count' | t: count: search.results_count, terms: search.terms }}</p>
          <div class="product-grid product-grid--4">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- else -%}
                <article class="product-card" style="border:1px solid var(--color-border);padding:20px;justify-content:space-between;">
                  <span class="mono-label">{{ item.object_type | upcase }}</span>
                  <a href="{{ item.url }}" class="h4">{{ item.title }}</a>
                  <p class="text-muted" style="font-size:0.875rem;">{{ item.content | strip_html | truncatewords: 20 }}</p>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search results",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "paper",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    }
  ]
}
{% endschema %}
