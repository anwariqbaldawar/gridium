<section class="section-pad color-{{ section.settings.color_scheme }}" style="min-height:100vh;display:flex;align-items:center;">
  <div class="container" style="max-width:580px;display:grid;gap:28px;">
    {% render 'logo', logo: section.settings.logo, size: 38 %}
    <div style="display:grid;gap:12px;">
      <span class="mono-label">01 / PRIVATE PREVIEW</span>
      <h1 class="h1">{{ section.settings.heading }}</h1>
      {%- if shop.password_message != blank -%}
        <p class="text-muted">{{ shop.password_message }}</p>
      {%- else -%}
        <p class="text-muted">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    {%- form 'storefront_password', class: 'password-form' -%}
      {%- if form.errors -%}
        <p class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div style="display:flex;flex-wrap:wrap;gap:10px;">
        <label class="visually-hidden" for="StorePassword">{{ 'general.password.password_label' | t }}</label>
        <input id="StorePassword" type="password" name="password" class="field__input" style="flex:1 1 220px;" placeholder="{{ 'general.password.password_label' | t }}" required>
        <button type="submit" class="button">{{ 'general.password.submit' | t }}</button>
      </div>
    {%- endform -%}

    <p class="text-muted" style="font-size:0.8125rem;">{{ 'general.password.owner_html' | t }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Main password",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "paper",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Season 04 Shirting Archive Preparing." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Our online flagship is currently transitioning collections. Enter your studio access key below." }
  ]
}
{% endschema %}
