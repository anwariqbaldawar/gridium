{%- liquid
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign first_step = step_blocks.first
-%}

<section class="about-craft color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="section-header__titles">
        <span class="mono-label">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.note != blank -%}
        <p class="spec-row__item">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>

    <div class="about-craft__layout">
      <div class="about-craft__steps">
        {%- for block in step_blocks -%}
          <details class="about-step" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="about-step__summary">
              <span class="about-step__index">0{{ forloop.index }}</span>
              <span class="about-step__title">{{ block.settings.title }}</span>
              <span class="about-step__meta">{{ block.settings.meta }}</span>
              {% render 'icon', name: 'plus', size: 16 %}
            </summary>
            <div class="about-step__panel">
              <p>{{ block.settings.text }}</p>
              {%- if block.settings.image != blank -%}
                <div class="about-step__media">
                  {{
                    block.settings.image
                    | image_url: width: 1000
                    | image_tag: widths: '400, 700, 1000', sizes: '(min-width: 1024px) 46vw, 100vw', loading: 'lazy', alt: block.settings.title
                  }}
                </div>
              {%- endif -%}
              {%- if block.settings.spec != blank -%}
                <p class="chip">{{ block.settings.spec }}</p>
              {%- endif -%}
            </div>
          </details>
        {%- endfor -%}
      </div>

      <figure class="about-craft__stage" data-reveal-media data-reveal>
        <div class="about-craft__stage-inner">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                widths: '480, 800, 1200',
                sizes: '(min-width: 1024px) 40vw, 100vw',
                loading: 'lazy',
                alt: section.settings.heading
            }}
          {%- elsif first_step.settings.image != blank -%}
            {{ first_step.settings.image | image_url: width: 1200 | image_tag: widths: '480, 800, 1200', sizes: '(min-width: 1024px) 40vw, 100vw', loading: 'lazy', alt: first_step.settings.title }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if section.settings.caption != blank -%}
          <figcaption class="mono-label">{{ section.settings.caption }}</figcaption>
        {%- endif -%}
      </figure>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About — Craft process",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "paper",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Mono meta label", "default": "04 / THE PROCESS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four stages between yarn and wardrobe." },
    { "type": "text", "id": "note", "label": "Right meta note", "default": "AVG. LEAD TIME: 94 DAYS" },
    { "type": "image_picker", "id": "image", "label": "Sticky image" },
    { "type": "text", "id": "caption", "label": "Image caption", "default": "FIG. 04 — SINGLE-NEEDLE COLLAR CONSTRUCTION, PORTO" },
    { "type": "checkbox", "id": "open_first", "label": "Open first stage by default", "default": true }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Stage",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Yarn & weaving" },
        { "type": "text", "id": "meta", "label": "Meta", "default": "PT · 21 DAYS" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Long-staple cotton is spun and woven in a single mill so the lot can be traced from bale to bolt. We test shrinkage after five washes before a fabric is approved." },
        { "type": "text", "id": "spec", "label": "Spec chip", "default": "130 GSM · TWO-PLY · OEKO-TEX 100" },
        { "type": "image_picker", "id": "image", "label": "Stage image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About — Craft process",
      "blocks": [
        { "type": "step", "settings": { "title": "Yarn & weaving", "meta": "PT · 21 DAYS", "spec": "130 GSM · TWO-PLY · OEKO-TEX 100", "text": "Long-staple cotton is spun and woven in a single mill so the lot can be traced from bale to bolt. We test shrinkage after five washes before a fabric is approved." } },
        { "type": "step", "settings": { "title": "Pattern & cutting", "meta": "ATELIER · 9 DAYS", "spec": "38 BLOCKS · 6 FITS", "text": "Every block is drafted in-house and graded across six sizes. Cutters work in short runs so a crooked panel is caught in the room, not in the warehouse." } },
        { "type": "step", "settings": { "title": "Sewing & finishing", "meta": "ATELIER · 41 DAYS", "spec": "22 SPI · 3.2MM MOTHER-OF-PEARL", "text": "Collars are single-needle set and unfused. Buttons are whipped onto thermally locked shanks so they flex instead of cracking." } },
        { "type": "step", "settings": { "title": "Inspection & archive", "meta": "NY · 23 DAYS", "spec": "100% HAND-CHECKED · 10-YEAR REPAIR STOCK", "text": "Two people check each shirt against the master sample. The pattern, the fabric lot and the machine operator are logged into the archive." } }
      ]
    }
  ]
}
{% endschema %}
