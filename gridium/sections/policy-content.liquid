{%- liquid
  assign p_type = section.settings.policy_type
  assign policy_html = ''
  if p_type == 'privacy' and shop.privacy_policy.body != blank
    assign policy_html = shop.privacy_policy.body
  elsif p_type == 'refund' and shop.refund_policy.body != blank
    assign policy_html = shop.refund_policy.body
  elsif p_type == 'terms' and shop.terms_of_service.body != blank
    assign policy_html = shop.terms_of_service.body
  elsif page.content != blank
    assign policy_html = page.content
  endif
  assign contact_email = section.settings.contact_email | default: 'concierge@gridiumstudio.com'
  assign updated = section.settings.last_updated | default: 'October 2026'
-%}

{% render 'breadcrumbs' %}

<section class="section-pad color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="policy-hero">
      <span class="mono-label">{{ 'policy.last_updated' | t }} · {{ updated }}</span>
      <h1>{{ page.title | default: section.settings.fallback_heading }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="policy-hero__intro">{{ section.settings.intro }}</p>
      {%- endif -%}

      {%- if section.settings.summary_1 != blank -%}
        <ul class="policy-summary">
          {%- for i in (1..4) -%}
            {%- capture key -%}summary_{{ i }}{%- endcapture -%}
            {%- if section.settings[key] != blank -%}
              <li>{{ section.settings[key] }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="policy-layout">
      <aside class="policy-toc" aria-label="{{ 'policy.contents' | t }}">
        <span class="mono-label">{{ 'policy.contents' | t }}</span>
        <ul class="policy-toc__list" data-policy-toc></ul>
        <div class="policy-toc__contact">
          <span class="mono-label">{{ 'policy.questions' | t }}</span>
          <a class="link-underline" href="mailto:{{ contact_email }}">{{ contact_email }}</a>
        </div>
      </aside>

      <article class="rte policy-document" data-policy-content>
        {%- if policy_html != blank -%}
          {{ policy_html }}
        {%- elsif p_type == 'privacy' -%}
          <h2>1. Who We Are</h2>
          <p>Gridium Studio (“Gridium”, “we”, “us”) designs, manufactures and sells a deliberately small catalogue of shirts and knitwear. This policy explains what personal data we collect when you browse or buy from our store, why we collect it, how long we keep it and the choices available to you.</p>
          <p>For the purposes of the EU and UK General Data Protection Regulation, Gridium Studio is the <strong>data controller</strong> of the personal data described here. Our storefront is hosted on Shopify Inc., which acts as our data processor.</p>

          <h2>2. Information We Collect</h2>
          <ul>
            <li><strong>Contact &amp; identity data</strong> — name, email address, telephone number and delivery or billing address.</li>
            <li><strong>Order data</strong> — items purchased, size and fit choices, order value, returns and exchange history.</li>
            <li><strong>Payment data</strong> — handled entirely by our PCI-DSS Level 1 payment providers. We receive a payment confirmation and the last four digits of a card; we never store full card numbers.</li>
            <li><strong>Technical data</strong> — IP address, device and browser type, operating system, referring URL and pages viewed.</li>
            <li><strong>Communication data</strong> — emails, chat transcripts and fit-consultation notes you send to our studio.</li>
            <li><strong>Marketing preferences</strong> — your newsletter opt-in status, size profile and product interests.</li>
          </ul>

          <h2>3. Why We Use Your Data</h2>
          <table>
            <thead>
              <tr><th>Purpose</th><th>Data used</th><th>Legal basis (GDPR Art. 6)</th></tr>
            </thead>
            <tbody>
              <tr><td>Fulfilling and delivering your order</td><td>Contact, order, payment confirmation</td><td>Performance of a contract</td></tr>
              <tr><td>Handling returns, exchanges and repairs</td><td>Order, communication</td><td>Performance of a contract</td></tr>
              <tr><td>Answering fit and product questions</td><td>Contact, communication</td><td>Legitimate interests</td></tr>
              <tr><td>Fraud prevention and payment security</td><td>Technical, order, IP address</td><td>Legitimate interests / legal obligation</td></tr>
              <tr><td>Tax, accounting and audit records</td><td>Order, contact</td><td>Legal obligation</td></tr>
              <tr><td>Studio newsletter and restock notices</td><td>Contact, marketing preferences</td><td>Consent (withdrawable at any time)</td></tr>
              <tr><td>Site performance and analytics</td><td>Technical, aggregated usage</td><td>Consent where cookies require it</td></tr>
            </tbody>
          </table>

          <h2>4. Cookies &amp; Local Storage</h2>
          <p>We keep cookies to the minimum required to run the store. Strictly necessary cookies power the shopping bag, checkout session, currency and region selection, and saved shortlist. Analytics and marketing cookies are only set after you consent through our cookie banner, and you can withdraw consent at any time.</p>
          <table>
            <thead>
              <tr><th>Category</th><th>Purpose</th><th>Retention</th></tr>
            </thead>
            <tbody>
              <tr><td>Strictly necessary</td><td>Cart, checkout, session, security</td><td>Session to 30 days</td></tr>
              <tr><td>Preferences</td><td>Region, currency, saved items, colour mode</td><td>Up to 12 months</td></tr>
              <tr><td>Analytics</td><td>Aggregated page and funnel measurement</td><td>Up to 24 months</td></tr>
              <tr><td>Marketing</td><td>Measuring campaigns you opt into</td><td>Up to 13 months</td></tr>
            </tbody>
          </table>

          <h2>5. Sharing &amp; Sub-Processors</h2>
          <p>We never sell or rent personal data. We share only what is necessary with vetted partners who are contractually bound to protect it:</p>
          <ul>
            <li><strong>Shopify Inc.</strong> — storefront, checkout and order management.</li>
            <li><strong>Payment providers</strong> — card, wallet and local payment processing.</li>
            <li><strong>Carriers</strong> — DHL, UPS and national postal services for delivery and returns.</li>
            <li><strong>Email &amp; support platforms</strong> — transactional mail, newsletter dispatch and client care.</li>
            <li><strong>Professional advisers</strong> — accountants, auditors and legal counsel where required.</li>
          </ul>

          <h2>6. International Transfers</h2>
          <p>Our partners may process data outside your country of residence. Where data leaves the EEA or the UK we rely on adequacy decisions or Standard Contractual Clauses, together with technical and organisational safeguards such as encryption in transit and at rest.</p>

          <h2>7. How Long We Keep Data</h2>
          <ul>
            <li><strong>Order records</strong> — 7 years, to satisfy tax and consumer-protection obligations.</li>
            <li><strong>Client care correspondence</strong> — 24 months from the last interaction.</li>
            <li><strong>Marketing contact records</strong> — until you unsubscribe, plus a short suppression period afterwards.</li>
            <li><strong>Fraud and security logs</strong> — up to 12 months.</li>
            <li><strong>Abandoned cart emails</strong> — 30 days unless you place an order.</li>
          </ul>

          <h2>8. Your Rights</h2>
          <p>Depending on where you live, you may have the right to access, correct, delete, restrict, port or object to the processing of your personal data, and to withdraw consent at any time. California residents may additionally request disclosure of categories of personal information collected and opt out of any “sale” or “sharing” of personal information — Gridium does not sell personal information.</p>
          <p>To exercise any right, email <a href="mailto:{{ contact_email }}">{{ contact_email }}</a>. We respond within 30 days and may ask for verification that protects your account. You also have the right to lodge a complaint with your local supervisory authority.</p>

          <h2>9. Security</h2>
          <p>All traffic to this store is encrypted with TLS. Access to client data is limited to a small number of studio staff, protected by multi-factor authentication and role-based permissions. We run regular reviews of our processors, and we will notify you and the relevant authority of any breach that is likely to present a high risk to your rights.</p>

          <h2>10. Children</h2>
          <p>Our store is intended for adults. We do not knowingly collect personal data from children under 16. If you believe a child has provided us with personal data, contact us and we will delete it.</p>

          <h2>11. Automated Decisions</h2>
          <p>We do not make decisions with legal or similarly significant effects about you based solely on automated processing. Recommendations you see in-store are based on aggregate behaviour and can be ignored without affecting your order.</p>

          <h2>12. Changes &amp; Contact</h2>
          <p>We may update this policy as our services evolve; the “last updated” date above always reflects the current version, and material changes will be announced on this page or by email.</p>
          <p>Questions, requests or complaints: <a href="mailto:{{ contact_email }}">{{ contact_email }}</a> — or write to Gridium Studio, Data Protection, Rua da Fábrica 14, 4050-262 Porto, Portugal.</p>
        {%- else -%}
          <h2>1. 30-Day Return &amp; Exchange Window</h2>
          <p>We accept returns and complimentary size exchanges within 30 days of delivery. Shirts must remain unworn, unwashed, unaltered and returned in their original archival packaging with garment tags attached.</p>
          <h2>2. Instant Size Exchanges</h2>
          <p>Need a closer or more relaxed fit? Request an exchange using your order number through our Contact page and we will reserve your replacement size the moment the carrier scans your parcel.</p>
          <h2>3. Refund Processing</h2>
          <p>Once your return is inspected at our studio warehouse, approved refunds are credited to the original payment method within 3–5 business days. Original express shipping upgrades are non-refundable.</p>
          <h2>4. International Duties &amp; Returns</h2>
          <p>International clients may generate a DHL or UPS return airway bill through client care. Import duties paid directly to local customs authorities can be reclaimed locally.</p>
          <h2>5. Quality Guarantee</h2>
          <p>In the rare event of a mill weave flaw or seam defect, contact our atelier team with a photograph for an immediate complimentary replacement.</p>
        {%- endif -%}
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Policy document",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "paper",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    },
    {
      "type": "select",
      "id": "policy_type",
      "label": "Policy source",
      "default": "privacy",
      "options": [
        { "value": "privacy", "label": "Privacy Policy (shop.privacy_policy)" },
        { "value": "refund", "label": "Refund Policy (shop.refund_policy)" },
        { "value": "terms", "label": "Terms of Service (shop.terms_of_service)" }
      ]
    },
    { "type": "text", "id": "fallback_heading", "label": "Fallback heading", "default": "Privacy Policy" },
    { "type": "text", "id": "last_updated", "label": "Last updated", "default": "October 2026" },
    { "type": "text", "id": "contact_email", "label": "Privacy contact email", "default": "concierge@gridiumstudio.com" },
    { "type": "textarea", "id": "intro", "label": "Intro paragraph", "default": "Your measurements, orders and messages belong to you. This page explains exactly what we collect, why we collect it, and the controls you have." },
    { "type": "text", "id": "summary_1", "label": "Summary point 1", "default": "We never sell or rent your personal data." },
    { "type": "text", "id": "summary_2", "label": "Summary point 2", "default": "Card details are handled by PCI-DSS Level 1 providers." },
    { "type": "text", "id": "summary_3", "label": "Summary point 3", "default": "Analytics cookies are optional and consent-based." },
    { "type": "text", "id": "summary_4", "label": "Summary point 4", "default": "You can request a copy or deletion of your data at any time." }
  ],
  "presets": [{ "name": "Policy document" }]
}
{% endschema %}
