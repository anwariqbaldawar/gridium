{%- liquid
  assign stat_blocks = section.blocks | where: 'type', 'stat'
  assign value_blocks = section.blocks | where: 'type', 'value'
%}

<section class="about-story color-{{ section.settings.color_scheme }} section-pad section-border-bottom">
  <div class="container">
    <div class="about-story__head">
      <div class="about-story__statement" data-reveal>
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="display-xl">{{ section.settings.heading }}</h2>
      </div>
      <div class="about-story__lead" data-reveal data-reveal-delay="1">
        <p class="text-lead">{{ section.settings.lead }}</p>
        {%- if section.settings.lead_secondary != blank -%}
          <p class="text-muted text-small">{{ section.settings.lead_secondary }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if stat_blocks.size > 0 -%}
      <div class="about-stats">
        {%- for block in stat_blocks -%}
          <div class="about-stat" data-reveal data-reveal-delay="{{ forloop.index }}" {{ block.shopify_attributes }}>
            <span class="about-stat__value">{{ block.settings.number }}</span>
            <span class="about-stat__label">{{ block.settings.label }}</span>
            {%- if block.settings.caption != blank -%}
              <p class="about-stat__caption">{{ block.settings.caption }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if value_blocks.size > 0 -%}
      <div class="about-story__values">
        <div class="about-story__values-head" data-reveal>
          <span class="mono-label">{{ section.settings.values_eyebrow }}</span>
          <span class="section-index">{{ section.settings.values_note }}</span>
        </div>
        <ul class="about-principles">
          {%- for block in value_blocks -%}
            <li class="about-principle" data-reveal data-reveal-delay="{{ forloop.index }}" {{ block.shopify_attributes }}>
              <span class="about-principle__index">0{{ forloop.index }}</span>
              <h3 class="about-principle__title">{{ block.settings.title }}</h3>
              <p class="about-principle__text">{{ block.settings.text }}</p>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.about-story { overflow: hidden; }
.about-story__head {
  display: grid;
  gap: clamp(24px, 4vw, 56px);
  align-items: end;
}
.about-story__statement { display: grid; gap: 18px; }
.about-story__statement h2 { max-width: 15ch; }
.about-story__lead { display: grid; gap: 14px; max-width: 50ch; }
.about-story__values { margin-top: clamp(48px, 7vw, 96px); }
.about-story__values-head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  padding-bottom: 18px;
  border-bottom: 1px solid var(--color-border);
}
.about-story__values .about-principles { margin-top: 0; border-top: 0; }
@media (min-width: 1024px) {
  .about-story__head { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "About statement & values",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "paper",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Mono meta label", "default": "02 / WHY WE EXIST" },
    { "type": "text", "id": "heading", "label": "Statement headline", "default": "One garment category. Perfected without noise." },
    { "type": "textarea", "id": "lead", "label": "Lead paragraph", "default": "Founded on the conviction that a shirt is the architectural anchor of modern dress, Gridium develops permanent shirting blocks in partnership with family-owned European mills." },
    { "type": "textarea", "id": "lead_secondary", "label": "Secondary paragraph", "default": "We do not chase drops. We reorder the fabrics that earned their place, retire the ones that did not, and keep the pattern table honest." },
    { "type": "text", "id": "values_eyebrow", "label": "Values heading", "default": "DESIGN PRINCIPLES" },
    { "type": "text", "id": "values_note", "label": "Values meta note", "default": "APPLIED TO EVERY BLOCK SINCE 2016" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Metric stat",
      "settings": [
        { "type": "text", "id": "label", "label": "Mono label", "default": "STITCH DENSITY" },
        { "type": "text", "id": "number", "label": "Value", "default": "22 SPI" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Single-needle lockstitch across every side seam." }
      ]
    },
    {
      "type": "value",
      "name": "Numbered value",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Pattern discipline" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Graded across 6 sizes with pitched armholes for natural movement without excess volume." }
      ]
    }
  ],
  "presets": [{ "name": "About statement & values" }]
}
{% endschema %}
