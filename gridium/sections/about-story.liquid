{% render 'breadcrumbs' %}

<section class="section-pad section-border-bottom color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div style="max-width:860px;display:grid;gap:20px;" data-reveal>
      <span class="mono-label">{{ section.settings.eyebrow }}</span>
      <h1 class="display-xl">{{ section.settings.heading }}</h1>
      <p class="text-lead">{{ section.settings.lead }}</p>
    </div>

    {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
    {%- if stat_blocks.size > 0 -%}
      <div class="usp-grid" style="margin-top:56px;" data-reveal>
        {%- for block in stat_blocks -%}
          <div class="usp-card" {{ block.shopify_attributes }}>
            <span class="mono-label">{{ block.settings.label }}</span>
            <p class="h1">{{ block.settings.number }}</p>
            <p class="text-muted" style="font-size:0.875rem;">{{ block.settings.caption }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign value_blocks = section.blocks | where: 'type', 'value' -%}
    {%- if value_blocks.size > 0 -%}
      <div style="margin-top:64px;">
        <span class="mono-label" style="display:block;margin-bottom:24px;">{{ section.settings.values_eyebrow }}</span>
        <div class="testimonials-grid">
          {%- for block in value_blocks -%}
            <div class="testimonial-card" {{ block.shopify_attributes }} data-reveal>
              <span class="mono-label">0{{ forloop.index }} / PRINCIPLE</span>
              <div style="display:grid;gap:10px;">
                <h2 class="h4">{{ block.settings.title }}</h2>
                <p class="text-muted" style="font-size:0.9375rem;">{{ block.settings.text }}</p>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About statement & values",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "paper",
      "options": [
        { "value": "paper", "label": "t:sections.all.color_scheme.options.paper" },
        { "value": "stone", "label": "t:sections.all.color_scheme.options.stone" },
        { "value": "midnight", "label": "t:sections.all.color_scheme.options.midnight" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Mono meta label", "default": "01 / ABOUT GRIDIUM STUDIO" },
    { "type": "text", "id": "heading", "label": "Statement headline", "default": "One Garment Category. Perfected Without Noise." },
    { "type": "textarea", "id": "lead", "label": "Lead paragraph", "default": "Founded on the conviction that a shirt is the architectural anchor of modern dress, Gridium develops permanent shirting blocks in partnership with family-owned European mills." },
    { "type": "text", "id": "values_eyebrow", "label": "Values heading", "default": "02 / DESIGN PRINCIPLES" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Metric stat",
      "settings": [
        { "type": "text", "id": "label", "label": "Mono label", "default": "STITCH DENSITY" },
        { "type": "text", "id": "number", "label": "Value", "default": "22 SPI" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Single-needle lockstitch across every side seam." }
      ]
    },
    {
      "type": "value",
      "name": "Numbered value",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Pattern Discipline" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Graded across 6 sizes with pitched armholes for natural movement without excess volume." }
      ]
    }
  ],
  "presets": [{ "name": "About statement & values" }]
}
{% endschema %}
